    "check": "pnpm build:nip-mkt && pnpm verify:immortal-artifact && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
